package partials

// PasswordFormProps holds data for the change-password form partial (#97).
type PasswordFormProps struct {
	Errors  map[string]string
	Success bool
}

// PasswordForm renders the change-password fields as a standalone fragment
// (for HTMX swaps into #password-form). The authenticated session is the
// credential: GoTrue updates the password on the bearer token without the
// current password, matching the password-reset flow (#71).
templ PasswordForm(props PasswordFormProps) {
	<div class="space-y-4">
		if props.Success {
			<div
				x-data="{ show: true }"
				x-show="show"
				x-init="setTimeout(() => show = false, 3000)"
				class="bg-success/10 text-success px-4 py-2 rounded"
				role="status"
			>
				Password updated.
			</div>
		}
		<div>
			<label for="new-password" class="block text-sm font-medium text-foreground">New password</label>
			<input
				type="password"
				name="password"
				id="new-password"
				autocomplete="new-password"
				required
				class="input mt-1"
			/>
			if errMsg, ok := props.Errors["password"]; ok {
				<p class="text-danger text-sm mt-1">{ errMsg }</p>
			}
		</div>
		<div>
			<label for="new-password-confirm" class="block text-sm font-medium text-foreground">Confirm new password</label>
			<input
				type="password"
				name="password_confirm"
				id="new-password-confirm"
				autocomplete="new-password"
				required
				class="input mt-1"
			/>
			if errMsg, ok := props.Errors["password_confirm"]; ok {
				<p class="text-danger text-sm mt-1">{ errMsg }</p>
			}
		</div>
		<div class="mt-2">
			<button type="submit" class="btn btn-primary" hx-indicator=".password-indicator">Update password</button>
			<span class="password-indicator hidden text-muted-foreground ml-2">Updating...</span>
		</div>
	</div>
}
