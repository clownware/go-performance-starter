package partials

import "fmt"

// Dashboard progress widgets (design brief priority 2, #69). The page ships
// one skeleton slot per widget; each slot fetches its fragment over HTMX on
// load and swaps itself out (outerHTML), so the skeleton is the loading
// state and the fragment is the resting state — the skeleton-loading
// pattern from the /patterns showcase, applied to real RLS-scoped data.
//
// Progressive enhancement (ADR-007/012): without JavaScript the skeleton
// never swaps, so each slot carries a <noscript> link to its own fragment
// endpoint — the same handler, the same HTML, just not inlined. The widget
// fragments are standalone (no layout) either way.

// QuizAttemptRowProps is one row of the recent-attempts list.
type QuizAttemptRowProps struct {
	// Slug links the row back to its question; empty when the question no
	// longer exists (the row still renders — the history is the user's).
	Slug    string
	Prompt  string
	Correct bool
}

// QuizProgressProps holds the quiz score history widget data.
type QuizProgressProps struct {
	// Attempts is the number of answers recorded (within the handler's
	// fetch window); Correct is the all-time correct count.
	Attempts int
	Correct  int
	// Percent is Correct/Attempts rounded half-up, 0 when there are no
	// attempts.
	Percent int
	// Recent is the most recent attempts, newest first.
	Recent []QuizAttemptRowProps
}

// FlashcardProgressProps holds the cards-to-review widget data.
type FlashcardProgressProps struct {
	Total    int
	Known    int
	ToReview int
}

func quizAttemptURL(slug string) string {
	return fmt.Sprintf("/learn/quiz?q=%s", slug)
}

// QuizWidgetSkeleton is the quiz slot as the page ships it: a pulsing
// placeholder that HTMX replaces with QuizProgressWidget on load.
templ QuizWidgetSkeleton() {
	<section
		id="widget-quiz"
		data-testid="widget-quiz-skeleton"
		hx-get="/dashboard/widgets/quiz"
		hx-trigger="load"
		hx-swap="outerHTML"
		aria-busy="true"
		aria-labelledby="widget-quiz-title"
		class="bg-surface rounded-lg shadow-md p-6"
	>
		<h2 id="widget-quiz-title" class="text-lg font-semibold mb-4">Quiz progress</h2>
		<div class="animate-pulse space-y-3" aria-hidden="true">
			<div class="h-8 rounded bg-border w-1/3"></div>
			<div class="h-3 rounded bg-border w-1/2"></div>
			<div class="h-3 rounded bg-border w-full"></div>
			<div class="h-3 rounded bg-border w-5/6"></div>
			<div class="h-3 rounded bg-border w-2/3"></div>
		</div>
		<span class="sr-only">Loading quiz progress…</span>
		<noscript>
			<a href="/dashboard/widgets/quiz" class="text-link underline text-sm">Load quiz progress</a>
		</noscript>
	</section>
}

// FlashcardWidgetSkeleton is the flashcards slot as the page ships it.
templ FlashcardWidgetSkeleton() {
	<section
		id="widget-flashcards"
		data-testid="widget-flashcards-skeleton"
		hx-get="/dashboard/widgets/flashcards"
		hx-trigger="load"
		hx-swap="outerHTML"
		aria-busy="true"
		aria-labelledby="widget-flashcards-title"
		class="bg-surface rounded-lg shadow-md p-6"
	>
		<h2 id="widget-flashcards-title" class="text-lg font-semibold mb-4">Cards to review</h2>
		<div class="animate-pulse space-y-3" aria-hidden="true">
			<div class="h-8 rounded bg-border w-1/4"></div>
			<div class="h-3 rounded bg-border w-1/2"></div>
			<div class="h-3 rounded bg-border w-2/3"></div>
		</div>
		<span class="sr-only">Loading cards to review…</span>
		<noscript>
			<a href="/dashboard/widgets/flashcards" class="text-link underline text-sm">Load cards to review</a>
		</noscript>
	</section>
}

// QuizProgressWidget is the loaded quiz score history: headline stats plus
// the most recent attempts, or the empty state. A standalone fragment.
templ QuizProgressWidget(props QuizProgressProps) {
	<section
		id="widget-quiz"
		data-testid="widget-quiz"
		aria-labelledby="widget-quiz-title"
		class="bg-surface rounded-lg shadow-md p-6"
	>
		<h2 id="widget-quiz-title" class="text-lg font-semibold mb-4">Quiz progress</h2>
		if props.Attempts == 0 {
			<div data-testid="widget-quiz-empty" class="text-muted-foreground">
				<p class="mb-2">No quiz attempts yet.</p>
				<p class="text-sm">
					<a href="/learn/quiz" class="text-link underline">Take the architecture quiz</a>
					and your score history shows up here.
				</p>
			</div>
		} else {
			<dl class="grid grid-cols-3 gap-4 mb-5">
				<div>
					<dt class="text-xs uppercase tracking-wide text-muted-foreground">Correct</dt>
					<dd class="text-2xl font-semibold text-success" data-testid="quiz-correct">{ fmt.Sprint(props.Correct) }</dd>
				</div>
				<div>
					<dt class="text-xs uppercase tracking-wide text-muted-foreground">Attempts</dt>
					<dd class="text-2xl font-semibold" data-testid="quiz-attempts">{ fmt.Sprint(props.Attempts) }</dd>
				</div>
				<div>
					<dt class="text-xs uppercase tracking-wide text-muted-foreground">Accuracy</dt>
					<dd class="text-2xl font-semibold" data-testid="quiz-percent">{ fmt.Sprintf("%d%%", props.Percent) }</dd>
				</div>
			</dl>
			<h3 class="text-sm font-medium text-muted-foreground mb-2">Recent attempts</h3>
			<ol class="divide-y divide-border" aria-label="Recent quiz attempts">
				for _, row := range props.Recent {
					<li data-testid="quiz-attempt" class="py-2 flex items-start justify-between gap-3 text-sm">
						if row.Slug != "" {
							<a href={ templ.SafeURL(quizAttemptURL(row.Slug)) } class="text-link underline">{ row.Prompt }</a>
						} else {
							<span class="text-muted-foreground">{ row.Prompt }</span>
						}
						if row.Correct {
							<span class="shrink-0 font-medium text-success">Correct</span>
						} else {
							<span class="shrink-0 font-medium text-danger">Incorrect</span>
						}
					</li>
				}
			</ol>
			<p class="mt-4 text-sm">
				<a href="/learn/quiz" class="text-link underline">Continue the quiz</a>
			</p>
		}
	</section>
}

// FlashcardProgressWidget is the loaded cards-to-review count, or the empty
// state. A standalone fragment.
templ FlashcardProgressWidget(props FlashcardProgressProps) {
	<section
		id="widget-flashcards"
		data-testid="widget-flashcards"
		aria-labelledby="widget-flashcards-title"
		class="bg-surface rounded-lg shadow-md p-6"
	>
		<h2 id="widget-flashcards-title" class="text-lg font-semibold mb-4">Cards to review</h2>
		if props.Total == 0 {
			<div data-testid="widget-flashcards-empty" class="text-muted-foreground">
				<p class="mb-2">No flashcards yet.</p>
				<p class="text-sm">
					Miss a question on the
					<a href="/learn/quiz" class="text-link underline">architecture quiz</a>
					and save it as a flashcard to review here.
				</p>
			</div>
		} else {
			<p class="mb-4">
				// text-primary is large text here (≥ 3:1, tokens_contrast_test); small text would use text-link.
				<span class="text-4xl font-semibold text-primary" data-testid="flashcards-to-review">{ fmt.Sprint(props.ToReview) }</span>
				<span class="ml-2 text-muted-foreground">
					if props.ToReview == 1 {
						card to review
					} else {
						cards to review
					}
				</span>
			</p>
			<dl class="flex gap-6 text-sm mb-4">
				<div>
					<dt class="text-xs uppercase tracking-wide text-muted-foreground">Known</dt>
					<dd class="font-medium text-success" data-testid="flashcards-known">{ fmt.Sprint(props.Known) }</dd>
				</div>
				<div>
					<dt class="text-xs uppercase tracking-wide text-muted-foreground">Total</dt>
					<dd class="font-medium" data-testid="flashcards-total">{ fmt.Sprint(props.Total) }</dd>
				</div>
			</dl>
			<p class="text-sm">
				<a href="/learn/flashcards" class="text-link underline">Review your flashcards</a>
			</p>
		}
	</section>
}
