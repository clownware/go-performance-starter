package components

import "fmt"

// formMethod returns the method attribute, defaulting to "post".
func formMethod(props FormProps) string {
	if props.Method != "" {
		return props.Method
	}
	return "post"
}

// formClass returns the CSS class for the form element.
func formClass(props FormProps) string {
	if props.Class != "" {
		return props.Class
	}
	return "space-y-6"
}

templ Form(props FormProps) {
	<form
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Action != "" {
			action={ templ.SafeURL(props.Action) }
		}
		method={ formMethod(props) }
		class={ formClass(props) }
		{ props.Attrs... }
	>
		{ children... }
	</form>
}

// ---------------------------------------------------------------------------
// FormValidation — Alpine.js client + server validation input
// ---------------------------------------------------------------------------

// formValidationType returns the input type, defaulting to "text".
func formValidationType(props FormValidationProps) string {
	if props.Type != "" {
		return props.Type
	}
	return "text"
}

// formValidationClass returns the wrapper class, defaulting to "mb-4".
func formValidationClass(props FormValidationProps) string {
	if props.Class != "" {
		return props.Class
	}
	return "mb-4"
}

// formValidationRequiredMsg returns the required validation message.
func formValidationRequiredMsg(props FormValidationProps) string {
	if props.RequiredMessage != "" {
		return props.RequiredMessage
	}
	return "This field is required"
}

// formValidationPatternMsg returns the pattern validation message.
func formValidationPatternMsg(props FormValidationProps) string {
	if props.PatternMessage != "" {
		return props.PatternMessage
	}
	return "Please enter a valid value"
}

templ FormValidation(props FormValidationProps) {
	<!-- formField is registered in app.js (ADR-036): the rules ride data-*
	     attributes, so prop values reach the browser through templ's
	     attribute escaping, never a hand-built JS literal. -->
	<div
		x-data="formField"
		data-value={ props.Value }
		data-required={ fmt.Sprint(props.Required) }
		data-pattern={ props.Pattern }
		data-min-length={ fmt.Sprint(props.MinLength) }
		data-max-length={ fmt.Sprint(props.MaxLength) }
		data-server-error={ props.ServerError }
		data-required-message={ formValidationRequiredMsg(props) }
		data-pattern-message={ formValidationPatternMsg(props) }
		class={ formValidationClass(props) }
	>
		if props.Label != "" {
			<label
				for={ props.ID }
				class="block text-sm font-medium text-foreground mb-1"
			>
				{ props.Label }
				if props.Required {
					<span class="text-danger">*</span>
				}
			</label>
		}
		<input
			id={ props.ID }
			name={ props.Name }
			type={ formValidationType(props) }
			placeholder={ props.Placeholder }
			class="input focus:outline-hidden focus:ring-primary focus:border-primary"
			x-model="value"
			@blur="touched = true"
			:class="{ 'border-danger': serverError || (!isValid && touched) }"
			if props.Required {
				required
			}
			if props.Pattern != "" {
				pattern={ props.Pattern }
			}
			if props.MinLength > 0 {
				minlength={ fmt.Sprintf("%d", props.MinLength) }
			}
			if props.MaxLength > 0 {
				maxlength={ fmt.Sprintf("%d", props.MaxLength) }
			}
			aria-describedby={ props.ID + "-error" }
			{ props.Attrs... }
		/>
		<div
			x-show="serverError || (!isValid && touched)"
			x-cloak
			class="mt-1 text-sm text-danger"
			id={ props.ID + "-error" }
			role="alert"
		>
			<span x-text="displayMessage"></span>
		</div>
		if props.HelperText != "" {
			<p class="mt-1 text-xs text-muted-foreground">
				{ props.HelperText }
			</p>
		}
	</div>
}
